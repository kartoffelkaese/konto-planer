# Datenbank (MariaDB/MySQL)
DATABASE_URL="mysql://user:password@localhost:3306/konto_planer"

# NextAuth / Auth.js (min. 32 Zeichen, z. B. openssl rand -base64 32)
AUTH_SECRET=""

# PFLICHT in Produktion: "true" hinter Reverse-Proxy (nginx, Caddy, …),
# "false" nur bei direktem Node-Zugriff ohne Proxy.
# WARNUNG: Steht hinter einem Proxy nicht "true", sehen alle Besucher für das
# Rate-Limiting wie dieselbe IP aus – z. B. wären dann nur 5 Registrierungen
# pro Stunde für die GESAMTE Seite möglich (Denial of Service).
TRUST_PROXY=true

# Produktion (öffentliche URL mit https, ohne trailing slash)
# AUTH_URL=https://konto-planer.de

# Lokale Entwicklung: AUTH_URL weglassen oder auf localhost setzen.
# Eine Produktions-URL in .env führt zu Login-/Redirect-Fehlern in der Dev-Umgebung.
AUTH_URL=http://localhost:3000

# Hinter Reverse-Proxy: wird automatisch aktiviert wenn AUTH_URL gesetzt ist.
# Explizit erzwingen: AUTH_TRUST_HOST=true
# Nur bei direktem Node-Zugriff ohne Proxy: AUTH_TRUST_HOST=false

# SMTP (E-Mail-Bestätigung bei Registrierung und E-Mail-Änderung)
SMTP_HOST=smtp.example.de
SMTP_PORT=587
SMTP_USER=noreply@example.de
SMTP_PASS=
SMTP_FROM="KontoPlaner <noreply@example.de>"
# SMTP_SECURE=true   # für Port 465

# Benutzerlevel („Start“ / „Komplett“, siehe src/lib/plans.ts).
# Ohne "true" haben alle Nutzer das Level „Komplett“ und es gibt keine Einschränkungen –
# so bleibt eine eigene Installation unverändert nutzbar.
# PLANS_ENABLED=true
