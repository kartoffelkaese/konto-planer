{
  "name": "konto-planer",
  "version": "8.4.5",
  "private": true,
  "scripts": {
    "dev": "next dev -H localhost",
    "build": "npm run typecheck && next build",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit",
    "start": "next start -H 127.0.0.1 -p 3001",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed-demo": "node scripts/seed-demo.mjs",
    "db:cleanup-unverified": "node scripts/cleanup-unverified-users.mjs",
    "postinstall": "prisma generate",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop konto-planer",
    "pm2:restart": "pm2 restart konto-planer",
    "pm2:logs": "pm2 logs konto-planer",
    "pm2:monitor": "pm2 monit konto-planer"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "@hono/node-server": "^1.19.13",
    "eslint": "10.8.0",
    "nodemailer": "^9.0.4",
    "sharp": "^0.35.0",
    "find-my-way": "^9.7.0",
    "valibot": "^1.4.2",
    "brace-expansion": "^5.0.8"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.21",
    "next": "^16.3.0",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^9.0.4",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "autoprefixer": "^10.5.4",
    "dotenv": "^17.4.2",
    "eslint": "10.8.0",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "sharp@0.35.0": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true
  }
}
